# Copy to .env (git-ignored) or set in Railway's Variables tab. All are optional.

# Server. Railway injects PORT automatically.
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins allowed to call the API cross-origin. Not needed when
# the backend serves the frontend (production) or Vite proxies it (local dev).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-memory simulation limits.
SIM_TTL_SECONDS=1800
MAX_SIMULATIONS=200
MAX_STEPS_PER_REQUEST=100

# Frontend build-time overrides (only when the API is on another origin).
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com
